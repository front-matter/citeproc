Style @2:1
  Class: "in-text"
  Version: "1.0"
  DemoteNonDroppingParticle: "never"
  InitializeWithHyphen: true
  PageRangeFormat: "expanded"
  Info: Info
    Title: "American Psychological Association 7th edition"
    TitleShort: "APA"
    ID: "http://www.zotero.org/styles/apa"
    Authors:
      - Person
        Name: "Brenton M. Wiernik"
        Email: "zotero@wiernik.org"
    CitationFormat: "author-date"
    Fields:
      - "psychology"
      - "generic-base"
    Links:
      - Link
        Href: "http://www.zotero.org/styles/apa"
        Rel: "self"
      - Link
        Href: "http://www.zotero.org/styles/apa-6th-edition"
        Rel: "template"
      - Link
        Href: "https://apastyle.apa.org/style-grammar-guidelines/references/examples"
        Rel: "documentation"
    Rights: "This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License"
    RightsLicense: "http://creativecommons.org/licenses/by-sa/3.0/"
    Updated: "2024-07-09T20:08:41+00:00"
  Locales:
