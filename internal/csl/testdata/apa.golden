  Macros:
    "access": Macro @1683:3
      Name: "access"
      Children:
        - Choose @1684:5
          Branches:
            - Branch @1685:7
              Match: "any"
              Variable:
                - "DOI"
              Children:
                - Text @1686:9
                  Source: "variable"
                  Name: "DOI"
                  Form: "long"
                  Prefix: "https://doi.org/"
            - Branch @1688:7
              Match: "all"
              Variable:
                - "URL"
              Children:
                - Group @1689:9
                  Delimiter: " "
                  Children:
                    - Choose @1690:11
                      Branches:
                        - Branch @1691:13
